# Copy this file to .env before running Docker Compose.
# 只在首次创建数据库时生效；库已存在时改这里不会改密码，请在后台改。
# 不填则使用默认密码 admin123。
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

WEB_PORT=8080
TZ=Asia/Shanghai
LOG_LEVEL=INFO
SQL_LOG_ENABLED=true

AUTO_REPLY_ENABLED=true
AUTO_DELIVERY_ENABLED=true
AI_REPLY_ENABLED=false

# Optional resource limits.
MEMORY_LIMIT=2048M
MEMORY_RESERVATION=512M
CPU_LIMIT=2.0
CPU_RESERVATION=0.5

# LinuxServer Chrome account containers; Docker socket access is required.
# Pull the official image before startup. See docs/account-browser.md.
ACCOUNT_BROWSER_IMAGE=lscr.io/linuxserver/chrome:latest
ACCOUNT_BROWSER_NETWORK=xianyu-browsers

# Absolute Docker HOST path (not /app inside the application container).
# ACCOUNT_BROWSER_CDP_CONFIG=/path/to/project/deploy/account-browser/cdp.conf
ACCOUNT_BROWSER_BIND=127.0.0.1
ACCOUNT_BROWSER_HOST=localhost

# Internal application address reachable from the native desktop network.
ACCOUNT_BROWSER_API_URL=http://xianyu-app:8080
